<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <turboFilter class="ch.qos.logback.classic.turbo.DuplicateMessageFilter">
        <allowedRepetitions>5</allowedRepetitions>
        <cacheSize>1000</cacheSize>
    </turboFilter>

    <springProperty scope="context" name="LOG_ROOT_DIR" source="PAWANDHAM_LOG_ROOT"
        defaultValue="../../../PDDH_Logs"/>
    <property name="SERVICE_NAME" value="pddh-backend"/>
    <property name="SERVICE_LOG_DIR" value="${LOG_ROOT_DIR}/${SERVICE_NAME}_logs"/>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${SERVICE_LOG_DIR}/${SERVICE_NAME}_log.txt</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${SERVICE_LOG_DIR}/archives/${SERVICE_NAME}_log_%d{dd-MM-yyyy}_%d{HHmmss,aux}_%i.txt</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [requestId=%X{requestId}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [requestId=%X{requestId}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.pddh" level="INFO"/>
    <logger name="org.hibernate.SQL" level="INFO"/>
    <logger name="org.springframework.jdbc.core.JdbcTemplate" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="FILE"/>
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
