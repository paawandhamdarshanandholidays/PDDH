<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <turboFilter class="ch.qos.logback.classic.turbo.DuplicateMessageFilter">
        <allowedRepetitions>5</allowedRepetitions>
        <cacheSize>1000</cacheSize>
    </turboFilter>
    <springProperty scope="context" name="SERVICE_NAME" source="spring.application.name" defaultValue="unknown-service"/>
    <springProperty scope="context" name="LOG_ROOT_DIR" source="PAWANDHAM_LOG_ROOT"
        defaultValue="../../../PDDH_Logs"/>

    <property name="SERVICE_LOG_DIR" value="${LOG_ROOT_DIR}/${SERVICE_NAME}_logs"/>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${SERVICE_LOG_DIR}/${SERVICE_NAME}_log.txt</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${SERVICE_LOG_DIR}/archives/${SERVICE_NAME}_log_%d{dd-MM-yyyy}_%d{HHmmss,aux}_%i.txt</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [requestId=%X{requestId}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [requestId=%X{requestId}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="KAFKA_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${SERVICE_LOG_DIR}/${SERVICE_NAME}_kafka.txt</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${SERVICE_LOG_DIR}/archives/${SERVICE_NAME}_kafka_%d{dd-MM-yyyy}_%d{HHmmss,aux}_%i.txt</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [requestId=%X{requestId}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="DETAIL_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${SERVICE_LOG_DIR}/${SERVICE_NAME}_detail.txt</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${SERVICE_LOG_DIR}/archives/${SERVICE_NAME}_detail_%d{dd-MM-yyyy}_%d{HHmmss,aux}_%i.txt</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [requestId=%X{requestId}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Loggers configuration -->
    <logger name="org.apache.kafka" level="INFO" additivity="false">
        <appender-ref ref="KAFKA_FILE"/>
    </logger>
    <logger name="org.springframework.kafka" level="INFO" additivity="false">
        <appender-ref ref="KAFKA_FILE"/>
    </logger>
    <logger name="com.pddh" level="INFO"/>
    <logger name="org.hibernate.SQL" level="INFO"/>
    <logger name="org.springframework.jdbc.core.JdbcTemplate" level="INFO"/>
    <logger name="com.netflix.discovery" level="INFO" additivity="false">
        <appender-ref ref="DETAIL_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>
    <logger name="org.springframework.cloud.netflix.eureka" level="INFO" additivity="false">
        <appender-ref ref="DETAIL_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>
    <logger name="com.pddh.roleprofile.RoleProfileService" level="INFO" additivity="false">
        <appender-ref ref="DETAIL_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>
    <logger name="com.pddh.auth_service.controller.AuthController" level="INFO" additivity="false">
        <appender-ref ref="DETAIL_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>
    <logger name="com.pddh.trips_service.service.BookingValidationListener" level="INFO" additivity="false">
        <appender-ref ref="DETAIL_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>
    <logger name="com.pddh.stays_service.service.BookingValidationListener" level="INFO" additivity="false">
        <appender-ref ref="DETAIL_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="FILE"/>
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>